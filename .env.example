# HTTP
HTTP_PORT=8082

# Postgres — reuses the paymentdb database from the order-hub-application infra stack.
DATABASE_URL=postgres://orderdb:postgres@localhost:5433/paymentdb?sslmode=disable

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=payment-group
DLT_REPROCESS_INTERVAL_MS=60000

# Stripe sandbox — from https://dashboard.stripe.com/test/apikeys and
# https://dashboard.stripe.com/test/webhooks
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme

# Mercado Pago sandbox — from https://www.mercadopago.com/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=TEST-changeme
MERCADOPAGO_WEBHOOK_SECRET=changeme

# Redirect URLs the client is sent to after completing/cancelling checkout — should point
# at the API Gateway, not directly at this service.
PAYMENT_SUCCESS_URL=http://localhost:8000/checkout/success
PAYMENT_CANCEL_URL=http://localhost:8000/checkout/cancel
